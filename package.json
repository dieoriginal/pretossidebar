{
  "name": "eventos-platform",
  "version": "0.1.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "cd apps/web && npm run dev",
    "build": "cd apps/web && npm run build",
    "lint": "cd apps/web && npm run lint",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules && rm -rf apps/*/.next apps/*/dist",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "install:all": "npm install && cd apps/web && npm install && cd ../../packages/shared-logic && npm install"
  },
  "devDependencies": {
    "prettier": "^3.1.0",
    "typescript": "^5"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@9.0.0"
}