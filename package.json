{
  "name": "shadcn-sidebar",
  "version": "0.1.1",
  "private": true,
  "main": "electron/main.js",
  "author": {
    "name": "Pretos Music Software"
  },
  "description": "Pretos Music Software: suite criativa para música, vídeo e narrativa",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently -k -n web,py -c green,cyan \"npm:dev:web\" \"npm:dev:py\"",
    "dev:web": "next dev",
    "dev:py": "bash -lc 'cd src/app/python && [ -d .venv ] || python3 -m venv .venv && source .venv/bin/activate && python3 -m pip install --upgrade pip && python3 -m pip install -r requirements.txt && python meter_api.py'",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "registry:build": "tsx ./scripts/build-registry.ts",
    "electron:dev": "concurrently -k -n next,electron -c green,cyan \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "next build",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:pack": "npm run electron:compile && electron-builder --dir",
    "electron:dist": "npm run build && npm run electron:compile && electron-builder",
    "electron:dist:mac": "npm run build && npm run electron:compile && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@clerk/nextjs": "^5.7.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^4.1.3",
    "@madzadev/audio-player": "^2.1.14",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.0.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.11",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@react-google-maps/api": "^2.20.7",
    "@sentry/nextjs": "^10.27.0",
    "@stepperize/react": "^5.1.5",
    "@stripe/stripe-js": "^8.5.3",
    "@types/file-saver": "^2.0.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "date-fns": "^3.6.0",
    "file-saver": "^2.0.5",
    "firebase": "^11.6.0",
    "geist": "^1.3.0",
    "immer": "^10.1.1",
    "js-cookie": "^3.0.5",
    "jspdf": "^3.0.1",
    "jspdf-invoice-template": "^1.4.4",
    "jspdf-invoice-template-nodejs": "^1.4.40",
    "localforage": "^1.10.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.377.0",
    "maplibre-gl": "^5.10.0",
    "next": "^14.2.26",
    "next-themes": "^0.4.3",
    "nodemailer": "^6.9.13",
    "nookies": "^2.5.2",
    "pako": "^2.1.0",
    "react": "^18",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18",
    "react-hook-form": "^7.54.2",
    "stripe": "^20.0.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2",
    "zustand": "^4.5.2",
    "electron-updater": "^6.2.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^9.2.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.1",
    "typescript": "^5",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "@types/electron": "^1.6.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.pretosmusic.fazteumambo",
    "productName": "Faz Teu Mambo",
    "copyright": "Copyright © 2025 Pretos Music Software",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/main.js",
      "electron/preload.js",
      "electron/updater.js",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "package.json",
      "node_modules/electron-updater/**/*",
      "node_modules/electron-log/**/*"
    ],
    "asarUnpack": [
      ".next/standalone"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dieoriginal",
        "repo": "pretossidebar"
      }
    ]
  }
}
