          },
        ];

      case 'third-party-hired':
        // Evento Contratado por Terceiros - Foco em contratos e cachet
        return [
          {
            name: "Contract",
            link: "/contract",
            timeframe: "Fase 1",
            description: "Contrato Principal, Cachet, Termos",
            status: currentStep === 0 ? "current" : currentStep > 0 ? "completed" : "upcoming",
            icon: <FileText className="w-4 h-4" />,
          },
          {
            name: "Rider",
            link: "/rider",
            timeframe: "Fase 1",
            description: "Rider Técnico, Alimentação, Transporte",
