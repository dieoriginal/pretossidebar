            icon: <Users className="w-4 h-4" />,
          },
          {
            name: "Speaker",
            link: "/speaker",
            timeframe: "Fase 2",
            description: "Contract, Curation, Program, Bio, Practice",
            status: currentStep === 5 ? "current" : currentStep > 5 ? "completed" : "upcoming",
            icon: <User className="w-4 h-4" />,
          },
          {
