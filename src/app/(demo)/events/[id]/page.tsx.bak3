            icon: <Settings className="w-4 h-4" />,
          },
          {
            name: "Venue",
            link: "/venue",
            timeframe: "Fase 1",
            description: "Local, Load-in/out, Backstage",
            status: currentStep === 2 ? "current" : currentStep > 2 ? "completed" : "upcoming",
