        {/* FEET Section */}
        <div className="border rounded p-4 shadow-sm">
          <h2 className="text-xl font-semibold mb-4">PÉ</h2>
          <Label className="mb-2 block">Tênis</Label>
          <div className="flex flex-wrap gap-4">
            {shoesOptions.map((option) => (
